# Copy to .env (never commit .env). Everything here is optional.

# 127.0.0.1 = this computer only. 0.0.0.0 = also phones on your Wi-Fi (an access code is then required).
HOST=127.0.0.1
PORT=4173

# HTTPS (self-signed certificate is created in data/tls unless you provide your own, e.g. from mkcert)
# HTTPS=1
# HTTPS_PORT=4443
# TLS_CERT=C:\path\to\cert.pem
# TLS_KEY=C:\path\to\key.pem

# Where contacts and card photos are stored
# BUZ_DATA_DIR=./data

# Fixed phone access code (default: random 6 digits, shown at start-up and in Settings on this computer)
# BUZ_ACCESS_CODE=

# Batch limits
# BUZ_MAX_FILES=25
# BUZ_MAX_FILE_MB=25
# BUZ_MAX_BATCH_MB=150

# Optional LinkedIn profile suggestions (Brave Search API; sends name + company to Brave)
# BRAVE_SEARCH_API_KEY=
